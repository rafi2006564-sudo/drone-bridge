        }
      },
      "required": [
        "url"
      ],
      "title": "VideoStartArgs",
      "type": "object"
    },
    "Waypoint": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "gimbal_pitch": "#/$defs/GimbalPitchAction",
                "photo": "#/$defs/PhotoAction"
              },
              "propertyName": "action"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/PhotoAction"
              },
              {
                "$ref": "#/$defs/GimbalPitchAction"
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        },
        "alt": {
          "maximum": 1500.0,
          "minimum": 0.0,
          "title": "Alt",
          "type": "number"
        },
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Lon",
          "type": "number"
        },
        "speed": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 25.0,
              "type": "number"
