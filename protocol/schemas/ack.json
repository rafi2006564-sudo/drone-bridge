{
  "$id": "drone-bridge/protocol/v1/ack.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "type": {
      "const": "ack",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "id",
    "ok"
  ],
  "title": "Ack",
  "type": "object"
}
